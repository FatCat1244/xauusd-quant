# ---------------------------------------------------------------------------
# xauusd-quant environment overrides.
# Copy to `.env` and edit. Every value here is OPTIONAL: config/data.yaml
# already contains working defaults for this machine.
#
# YAML string values are passed through os.path.expandvars(), so you can also
# reference these directly inside config/data.yaml as ${VAR_NAME}.
# ---------------------------------------------------------------------------

# Which YAML config the CLI loads when --config is not given.
XAUUSD_QUANT_CONFIG=config/data.yaml

# Absolute path to the raw tick file/directory. Overrides `raw_data_path`.
# Use this when the ~34 GB dataset lives outside the repository, e.g. on
# another drive or a network share.
# XAUUSD_RAW_DATA_PATH=D:/market-data/xauusd/2026.9.11XAUUSD_oanda-TICK-No Session.csv

# Override the processed-data destinations (useful to keep multi-GB Parquet
# output off the system drive).
# XAUUSD_PROCESSED_DATA_PATH=D:/market-data/xauusd/parquet
# XAUUSD_BARS_PATH=D:/market-data/xauusd/bars
# XAUUSD_METADATA_PATH=data/metadata

# Logging
# XAUUSD_LOG_LEVEL=INFO
# XAUUSD_LOG_FILE=logs/xauusd-quant.log
